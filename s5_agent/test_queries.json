{
  "tests": [
    {"query": "how many croissant do I have right now?", "expected_intent": "stock_query", "expected_product": "croissant"},
    {"query": "do I need to bake more donuts today?", "expected_intent": "stock_query", "expected_product": "donut"},
    {"query": "what is my chiffon stock level?", "expected_intent": "stock_query", "expected_product": "chiffon"},
    {"query": "how's the bread roll doing?", "expected_intent": "stock_query", "expected_product": "bread_roll"},
    {"query": "tell me about chocolate croissant", "expected_intent": "stock_query", "expected_product": "croissant_chocolate"},
    {"query": "any products running low?", "expected_intent": "stock_query", "expected_product": "all"},
    {"query": "what should I prepare for tomorrow?", "expected_intent": "stock_query", "expected_product": "all"},
    {"query": "how much bread coconut sold yesterday?", "expected_intent": "stock_query", "expected_product": "bread_coconut"},
    {"query": "do I have enough inventory for the weekend?", "expected_intent": "stock_query", "expected_product": "all"},
    {"query": "show me all stock", "expected_intent": "stock_query", "expected_product": "all"},

    {"query": "why am I throwing away so many croissants?", "expected_intent": "waste_analysis", "expected_product": "croissant"},
    {"query": "which product wastes the most?", "expected_intent": "waste_analysis", "expected_product": "all"},
    {"query": "how to reduce waste this week?", "expected_intent": "waste_analysis", "expected_product": "all"},
    {"query": "my spoilage is too high, help", "expected_intent": "waste_analysis", "expected_product": "all"},
    {"query": "what's expiring soon?", "expected_intent": "waste_analysis", "expected_product": "all"},

    {"query": "should I run a discount on chiffon?", "expected_intent": "promo_eval", "expected_product": "chiffon"},
    {"query": "any promo ideas for today?", "expected_intent": "promo_eval", "expected_product": "all"},
    {"query": "give me a deal for bread roll", "expected_intent": "promo_eval", "expected_product": "bread_roll"},
    {"query": "is it time to markdown croissants?", "expected_intent": "promo_eval", "expected_product": "croissant"},
    {"query": "what bundle should I offer?", "expected_intent": "promo_eval", "expected_product": "all"},

    {"query": "who is working today?", "expected_intent": "schedule_audit", "expected_product": "all"},
    {"query": "check my roster for problems", "expected_intent": "schedule_audit", "expected_product": "all"},
    {"query": "do I have enough bakers tomorrow?", "expected_intent": "schedule_audit", "expected_product": "all"},
    {"query": "any staffing issues this week?", "expected_intent": "schedule_audit", "expected_product": "all"},
    {"query": "is anyone on leave today?", "expected_intent": "schedule_audit", "expected_product": "all"},

    {"query": "how much did I earn today?", "expected_intent": "profit_analysis", "expected_product": "all"},
    {"query": "what is my profit margin overall?", "expected_intent": "profit_analysis", "expected_product": "all"},
    {"query": "which product makes the most money?", "expected_intent": "profit_analysis", "expected_product": "all"},
    {"query": "is croissant profitable?", "expected_intent": "profit_analysis", "expected_product": "croissant"},
    {"query": "show me revenue breakdown", "expected_intent": "profit_analysis", "expected_product": "all"},

    {"query": "give me a store health check", "expected_intent": "cross_source_audit", "expected_product": "all"},
    {"query": "how is everything looking?", "expected_intent": "cross_source_audit", "expected_product": "all"},
    {"query": "any problems I should know?", "expected_intent": "cross_source_audit", "expected_product": "all"},
    {"query": "full audit please", "expected_intent": "cross_source_audit", "expected_product": "all"},

    {"query": "compare croissant and donut", "expected_intent": "comparison_analysis", "expected_product": "croissant,donut"},
    {"query": "which is better, bread roll or coconut bread?", "expected_intent": "comparison_analysis", "expected_product": "bread_roll,bread_coconut"},
    {"query": "croissant versus chiffon sales", "expected_intent": "comparison_analysis", "expected_product": "croissant,chiffon"},

    {"query": "what's the weather today?", "expected_intent": "out_of_scope", "expected_product": "-"},
    {"query": "tell me a joke", "expected_intent": "out_of_scope", "expected_product": "-"},
    {"query": "how to make coffee?", "expected_intent": "out_of_scope", "expected_product": "-"},

    {"query": "stok croissant ada berapa?", "expected_intent": "stock_query", "expected_product": "croissant"},
    {"query": "kenapa banyak sangat waste minggu ni?", "expected_intent": "waste_analysis", "expected_product": "all"},
    {"query": "ada promo untuk donut tak?", "expected_intent": "promo_eval", "expected_product": "donut"},
    {"query": "siapa kerja hari ni?", "expected_intent": "schedule_audit", "expected_product": "all"},
