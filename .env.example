# MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=bakery_app
MYSQL_PASSWORD=
MYSQL_DATABASE=bakery_ai
MYSQL_SESSION_TIME_ZONE=+08:00
BAKERY_TIME_ZONE=Asia/Shanghai

# Optional OpenAI-compatible LLM provider
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# DeepSeek compatibility variables retained for one release
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Weather API (VisualCrossing)
WEATHER_API_KEY=

# JWT
BAKERY_ENV=development
JWT_SECRET=
BAKERY_ALLOW_LEGACY_PLAINTEXT_LOGIN=0

# Optional temporary business-date lock. Leave blank for real system time.
BAKERY_FIXED_BUSINESS_DATE=

# Optional local launcher overrides; packaged installations discover these paths
# from the per-user install manifest.
BAKERY_APP_HOME=
BAKERY_DATA_HOME=
BAKERY_COMPOSE_FILE=
BAKERY_RUNTIME_ENV=
BAKERY_DOCKER_CLI=
